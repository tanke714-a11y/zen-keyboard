#include <mouse-gesture.dtsi>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

&zip_mouse_gesture {
    stroke-size = <150>;
    idle-timeout-ms = <300>;
    enable-eager-mode;
    suppress-movement;

    desktop_right {
        pattern = <GESTURE_LEFT>;
        bindings = <&kp LC(RIGHT)>;
    };

    desktop_left {
        pattern = <GESTURE_RIGHT>;
        bindings = <&kp LC(LEFT)>;
    };

    mission_control {
        pattern = <GESTURE_UP>;
        bindings = <&kp LC(UP)>;
    };
};

/ {
    // Only routed by the Layer 6 listener override. Independent of the
    // global mouse_gesture activation used by the existing JKL; combo.
    zip_browser_gesture: zip_browser_gesture {
        compatible = "zmk,input-processor-mouse-gesture";
        #input-processor-cells = <0>;
        always-active;
        stroke-size = <150>;
        enable-eager-mode;
        // Single-stroke patterns execute immediately, never on a later idle timer.
        idle-timeout-ms = <0>;
        suppress-movement;

        browser_mb4 {
            pattern = <GESTURE_RIGHT>;
            bindings = <&mkp MB4>;
        };

        browser_mb5 {
            pattern = <GESTURE_LEFT>;
            bindings = <&mkp MB5>;
        };
    };

    combos {
        compatible = "zmk,combos";

        Layer_7 {
            bindings = <&mo 7>;
            key-positions = <45 46>;
        };

        browser_gesture_combo {
            bindings = <&mo 6>;
            key-positions = <7 8 9>;
            layers = <0 1>;
            timeout-ms = <50>;
            // Default release: any one of U/I/O released disables Layer 6.
        };

        gesture_combo {
            bindings = <&gesture_hold>;
            key-positions = <19 20 21 22>;
            layers = <0 1>;
        };

        lclk {
            bindings = <&mkp LCLK>;
            key-positions = <19 20>;
        };

        rclk {
            bindings = <&mkp RCLK>;
            key-positions = <20 21>;
        };

        mclk {
            bindings = <&mkp MCLK>;
            key-positions = <19 20 21>;
        };
    };

    macros {
        to_layer_0: to_layer_0 {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&to 0 &macro_param_1to1 &kp MACRO_PLACEHOLDER>;
            label = "TO_LAYER_0";
        };

        gesture_hold: gesture_hold {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <0>;
            bindings =
                <&macro_press>,
                <&mouse_gesture>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&mouse_gesture>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        layer_0 {
            bindings = <
&kp ESC    &kp Q         &kp W  &kp E             &kp R                   &kp T        &kp Y                   &kp U          &kp I  &kp O           &kp P           &kp DEL
&kp TAB    &kp A         &kp S  &kp D             &kp F                   &kp G        &kp H                   &kp J          &kp K  &kp L           &kp SEMI        &kp ENTER
&kp LSHFT  &kp Z         &kp X  &kp C             &kp V                   &kp B        &kp LG(NUMBER_4)        &kp MINUS      &kp N  &kp M           &kp COMMA       &kp DOT      &kp UP_ARROW  &mt RSHFT QUESTION
&kp LCTRL  &kp LEFT_ALT  &mo 3  &kp LEFT_COMMAND  &to_layer_0 LANGUAGE_2  &lt 2 SPACE  &to_layer_0 LANGUAGE_1  &kp BACKSPACE  &mo 2  &kp LEFT_ARROW  &kp DOWN_ARROW  &lt 3 RIGHT
            >;
        };

        mouse {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &mo 4   &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };

        symbols {
            bindings = <
&kp ESCAPE  &kp N1    &kp N2  &kp N3    &kp N4      &kp N5     &kp N6     &kp N7         &kp N8     &kp N9                &kp N0                 &kp DELETE
&trans      &kp EXCL  &kp AT  &kp HASH  &kp DOLLAR  &kp PRCNT  &kp CARET  &kp AMPERSAND  &kp ASTRK  &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &trans
&trans      &trans    &trans  &trans    &trans      &trans     &trans     &trans         &kp TILDE  &kp LEFT_BRACE        &kp RIGHT_BRACE        &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &kp SLASH
&trans      &trans    &trans  &trans    &trans      &trans     &trans     &trans         &trans     &trans                &trans                 &kp PLUS
            >;
        };

        numbers {
            bindings = <
&trans  &kp F1   &kp F2   &kp F3  &kp F4  &kp F5   &trans    &kp TAB  &kp KP_NUMBER_7  &kp KP_NUMBER_8  &kp KP_NUMBER_9  &kp SLASH
&trans  &kp F6   &kp F7   &kp F8  &kp F9  &kp F10  &kp HOME  &trans   &kp KP_NUMBER_4  &kp KP_NUMBER_5  &kp KP_NUMBER_6  &kp ASTRK
&trans  &kp F11  &kp F12  &trans  &trans  &trans   &trans    &trans   &kp END          &trans           &kp KP_NUMBER_1  &kp KP_NUMBER_2  &kp KP_NUMBER_3  &kp MINUS
&trans  &trans   &trans   &trans  &trans  &trans   &trans    &trans   &kp KP_NUMBER_0  &kp KP_DOT       &kp EQUAL        &kp PLUS
            >;
        };

        scroll {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };

        layer_5 {
            bindings = <
&kp ESC  &kp F1  &kp F2  &kp F3  &kp F4  &kp F5  &kp F6  &kp F7  &kp F8  &kp F9  &kp F10  &kp F12
&trans   &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans   &trans
&trans   &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans   &trans   &trans  &trans
&trans   &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans   &trans
            >;
        };

        browser_gesture {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };

        Bluetooth {
            bindings = <
&bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &bt BT_NXT      &trans  &trans  &trans  &trans  &trans  &trans
&bt BT_CLR    &trans        &trans        &trans        &trans        &bt BT_CLR_ALL  &trans  &trans  &trans  &trans  &trans  &trans
&out OUT_USB  &out OUT_BLE  &trans        &trans        &trans        &trans          &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans        &trans        &trans        &trans        &trans        &trans          &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };
    };
};
